    "/finance/commands/banking.transactions": {
      "post": {
        "summary": "transactions",
        "description": "Requires ready finance and banking modules, finance.write and banking.write. See docs/banking.md for mapping, limits and idempotency.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bank_account_id"
                ],
                "properties": {
                  "bank_account_id": {
                    "type": "string"
                  },
                  "after": {
                    "type": "string",
                    "pattern": "^([0-9a-f]{64})?$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; documented in banking.md"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Missing permission or module unavailable"
          },
          "409": {
            "description": "Changed preview or conflicting reference"
          }
        }
      }
    },
    "/finance/commands/banking.post": {
      "post": {
        "summary": "post",
        "description": "Requires ready finance and banking modules, finance.write and banking.write. See docs/banking.md for mapping, limits and idempotency.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "transaction_id",
                  "account_id",
                  "confirmed"
                ],
                "properties": {
                  "transaction_id": {
                    "type": "string"
                  },
                  "account_id": {
                    "type": "string"
                  },
                  "confirmed": {
                    "type": "boolean",
                    "const": true
                  },
                  "receivable_id": {
                    "type": "string"
                  },
                  "allocation_amount": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                },
                "dependentRequired": {
                  "receivable_id": [
                    "allocation_amount"
                  ],
                  "allocation_amount": [
                    "receivable_id"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; documented in banking.md"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Missing permission or module unavailable"
          },
          "409": {
            "description": "Changed preview or conflicting reference"
          }
        }
      }
    },
