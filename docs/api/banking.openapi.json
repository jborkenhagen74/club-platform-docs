        "description": "Requires ready finance and banking modules, finance.write and banking.write. See docs/banking.md for mapping, limits and idempotency.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "bank_account_id",
                  "format",
                  "contents",
                  "preview_hash",
                  "confirmed"
                ],
                "properties": {
                  "bank_account_id": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "csv",
                      "camt053"
                    ]
                  },
                  "contents": {
                    "type": "string"
                  },
                  "mapping": {
                    "type": "object"
                  },
                  "preview_hash": {
