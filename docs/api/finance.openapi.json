{
  "openapi": "3.0.3",
  "info": {
    "title": "Club Platform finance, contributions and purchases",
    "version": "1.0.0-pilot"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
