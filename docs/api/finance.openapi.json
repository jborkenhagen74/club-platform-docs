          },
          "assignment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "valid_until": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          }
        }
      },
      "contributions.bill": {
        "type": "object",
        "required": [
          "source_id",
          "assignment_id",
          "through"
        ],
        "properties": {
          "source_id": {
