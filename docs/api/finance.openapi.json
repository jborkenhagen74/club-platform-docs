  "paths": {
    "/finance/accounts/": {
      "get": {
        "summary": "Read account and module selectors (finance.read, plus optional module read permissions).",
        "description": "Each selector is bounded to 1000 records. Unlicensed or unauthorized optional module lists are empty.",
        "responses": {
          "200": {
            "description": "Object with accounts, owners, organizations, memberships, plans, assignments, products and items arrays."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Module entitlement, readiness or permission missing."
          }
        }
      }
    },
    "/finance/accounts/{account}": {
      "get": {
        "summary": "Read the shared ledger and derived balance (finance.read).",
        "parameters": [
          {
            "in": "path",
            "name": "account",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account, exact signed balance in cents, and immutable entries with open_amount/unallocated_amount where applicable."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Module entitlement, readiness or permission missing."
          },
          "404": {
            "description": "Referenced record not found."
          }
        }
      }
    },
    "/finance/commands/account.create": {
      "post": {
        "summary": "account.create",
        "description": "Requires finance.write, installed/enabled/licensed modules. Writes and audit are atomic. Maximum body size 16 KiB.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/account.create"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation succeeded; identical source_id and payload return the original result."
          },
          "400": {
            "description": "Invalid input or unsupported operation."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Module entitlement, readiness or permission missing."
          },
          "404": {
            "description": "Referenced record not found."
          },
          "409": {
            "description": "Source reused with different input, stale revision, or financial invariant conflict."
          }
        }
      }
    },
