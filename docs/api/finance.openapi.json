  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "account.create": {
        "type": "object",
        "required": [
          "source_id",
          "owner_id",
          "organization_id",
          "currency"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable idempotency key within the owning module. Retain across transport retries."
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "organization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "enum": [
              "EUR"
            ]
          }
        }
      },
      "receivable.create": {
        "type": "object",
        "required": [
          "source_id",
          "account_id",
          "amount",
          "booking_date",
          "due_date",
          "description"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable idempotency key within the owning module. Retain across transport retries."
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. Monetary fields are EUR cents."
          },
          "booking_date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "payment.create": {
        "type": "object",
        "required": [
          "source_id",
          "account_id",
          "amount",
          "booking_date",
          "description",
          "external_reference"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable idempotency key within the owning module. Retain across transport retries."
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. Monetary fields are EUR cents."
          },
          "booking_date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "external_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "allocation.create": {
        "type": "object",
        "required": [
          "source_id",
          "payment_id",
          "receivable_id",
          "amount"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable idempotency key within the owning module. Retain across transport retries."
          },
          "payment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "receivable_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. Monetary fields are EUR cents."
          }
        }
      },
      "entry.reverse": {
        "type": "object",
        "required": [
          "source_id",
          "entry_id",
          "booking_date",
          "description"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable idempotency key within the owning module. Retain across transport retries."
          },
          "entry_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "booking_date": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "plan.create": {
        "type": "object",
        "required": [
          "source_id",
          "organization_id",
          "name",
          "amount",
          "currency",
          "interval_months",
          "valid_from",
          "valid_until",
          "due_day"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable idempotency key within the owning module. Retain across transport retries."
          },
          "organization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. Monetary fields are EUR cents."
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "enum": [
              "EUR"
            ]
          },
          "interval_months": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. Monetary fields are EUR cents."
          },
          "valid_from": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          },
          "valid_until": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          },
          "due_day": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. Monetary fields are EUR cents."
          }
        }
      },
      "assignment.create": {
        "type": "object",
        "required": [
          "source_id",
          "membership_id",
          "plan_id",
          "account_id",
          "valid_from",
          "valid_until",
          "discount_bps"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Stable idempotency key within the owning module. Retain across transport retries."
          },
          "membership_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "plan_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "account_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "valid_from": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          },
          "valid_until": {
            "type": "string",
            "format": "date",
            "description": "ISO 8601 date, years 1900 through 9999."
          },
          "custom_amount": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. Monetary fields are EUR cents."
          },
          "discount_bps": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "description": "Exact nonnegative integer encoded as a decimal string. Monetary fields are EUR cents."
          }
        }
      },
      "assignment.end": {
        "type": "object",
        "required": [
          "source_id",
          "assignment_id",
          "valid_until"
        ],
        "properties": {
          "source_id": {
            "type": "string",
